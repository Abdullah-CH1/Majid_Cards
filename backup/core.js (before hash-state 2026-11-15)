  if (f === 'petal' || f === 'dust') {
    for (var i = 0; i < 14; i++) {
      var e = document.createElement('span'), s;
      if (f === 'petal') {e.className = 'pe' + (i % 2 ? ' alt' : ''); s = 6 + Math.random() * 6; e.style.width = s + 'px'; e.style.height = (s * 1.4) + 'px'; e.style.animationDuration = (6 + Math.random() * 4) + 's'}
