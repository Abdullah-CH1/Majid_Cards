    var b = document.createElement('button'); b.type = 'button'; b.className = 'th'; b.setAttribute('data-n', i + 1);
    b.setAttribute('data-cat', smp.cat || ''); b.setAttribute('aria-label', 'Sample ' + (i + 1) + ': ' + smp.name);
